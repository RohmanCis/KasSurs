# Supabase Postgres — pooler URL (PgBouncer, port 6543) untuk runtime/serverless
DATABASE_URL=

# Supabase Postgres — direct connection (port 5432) khusus Prisma migration
DIRECT_URL=

# Secret untuk sign JWT session cookie — generate: openssl rand -base64 32
JWT_SECRET=

# Akun admin pertama (FR-22) — dipakai `prisma db seed`, idempotent
SEED_ADMIN_PHONE=
SEED_ADMIN_PIN=

# Test DB terpisah untuk integration test (T-35+) - gunakan Supabase/SQLite terpisah, bukan DB produksi
TEST_DATABASE_URL=
